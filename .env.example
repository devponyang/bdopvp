# Default: no DB calls, all public pages and archived guides still render.
DB_ENABLED=false
# Fill these only when a NEW database is ready. Do not reuse exposed credentials.
DATABASE_URL=
# Generate a random secret of at least 32 characters.
SESSION_SECRET=
# bcrypt hash, never a plaintext password. See docs/rebuild.md.
ADMIN_PASSWORD_HASH=
# Exact public origin (no trailing slash). Local example:
SITE_ORIGIN=http://localhost:3000
